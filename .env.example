# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=ometv_clone
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:your-secure-password@localhost:5432/ometv_clone?schema=public"

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=your-redis-password
REDIS_URL="redis://:your-redis-password@localhost:6379"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── TURN Server ─────────────────────────────────────────
TURN_USERNAME=turnuser
TURN_PASSWORD=turnsecret
TURN_REALM=ometv.local
TURN_SERVER_URL=localhost
TURN_CREDENTIAL=your-turn-secret-change-in-production

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_TURN_URL=turn:localhost:3478

# ─── AWS (Production) ────────────────────────────────────
AWS_REGION=us-east-1
